{
  "manifest_version": 3,
  "name": "GiroAuto — Marketplace assistido",
  "short_name": "GiroAuto",
  "version": "1.5.0",
  "description": "Publica, exclui e republica com um clique os veículos do painel GiroAuto no Facebook Marketplace.",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://web.facebook.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "GiroAuto"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "key": "",
  "externally_connectable": {
    "matches": [
      "https://giroauto.onrender.com/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  }
}