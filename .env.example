# Copie para .env e preencha. Inicie com: npm start  (o servidor lê o .env automaticamente)

# Endereço público do painel (sem barra no final). A Meta precisa acessar o feed do catálogo
# e as fotos por esse endereço, e o login com Facebook volta para ele.
PUBLIC_URL=http://localhost:3333
PORT=3333

# Segredo longo e aleatório para assinar sessões e criptografar o token da Meta.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=troque-por-um-segredo-aleatorio

# App da Meta (developers.facebook.com > Meus apps > Criar app > tipo "Empresa")
META_APP_ID=
META_APP_SECRET=
# Opcional: ID da configuração do "Login do Facebook para Empresas". Se vazio, usa escopos.
META_LOGIN_CONFIG_ID=
META_API_VERSION=v25.0

# Pasta dos dados (banco SQLite e fotos)
DATA_DIR=./data

# Armazenamento permanente gratuito (Supabase > Project Settings > API).
# Sem isso, lojas, veículos e fotos ficam só no disco do servidor e somem a cada nova versão no Render.
# ATENÇÃO: use estas chaves só no servidor (Render). Se o painel local usar as mesmas chaves
# ao mesmo tempo que o Render, um sobrescreve os dados do outro.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
