{
  "name": "giroauto",
  "version": "1.2.0",
  "private": true,
  "description": "Painel para lojas de veículos: estoque, anúncios orgânicos no Marketplace (via extensão) e campanhas no Facebook e Instagram (API de Marketing da Meta).",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --no-warnings=ExperimentalWarning src/server.js",
    "dev": "node --no-warnings=ExperimentalWarning --watch src/server.js",
    "test": "node --no-warnings=ExperimentalWarning --test test/*.test.js",
    "build:bookmarklet": "esbuild assist/filler.src.js --minify --target=chrome100 --charset=utf8 --outfile=public/bookmarklet.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  }
}
